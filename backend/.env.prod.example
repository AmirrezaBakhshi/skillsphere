# Copy this to backend/.env.prod and fill in real values before deploying.
# Unlike backend/.env (dev), nothing here has an insecure default baked
# into settings/prod.py - a missing required value fails loudly at
# container startup instead of silently falling back to something unsafe.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Your real domain(s), comma-separated, no scheme/port - e.g. skillsphere.example.com
DJANGO_ALLOWED_HOSTS=

# Same domain(s), WITH scheme - e.g. https://skillsphere.example.com
CORS_ALLOWED_ORIGINS=

# Built into the frontend's compiled JS bundle at image build time (see
# frontend/Dockerfile.prod) - must be publicly reachable from users' browsers,
# not an internal Docker hostname. e.g. https://skillsphere.example.com/api/v1
NEXT_PUBLIC_API_BASE_URL=

POSTGRES_PASSWORD=

# Leave DJANGO_SECURE_SSL_REDIRECT=True unless Nginx (or whatever's in
# front of this) genuinely isn't terminating TLS - see
# DOCUMENTATION_STAGE6.md section 3 before changing this.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=2592000

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Point this at a real provider before going live - the console backend
# (dev's default) only prints emails to container logs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@your-domain.example.com

PROJECT_UPLOAD_MAX_SIZE_BYTES=26214400
PROJECT_UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,application/zip,application/x-zip-compressed,image/png,image/jpeg

DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
